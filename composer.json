{
	"name": "marthrown/marthrown-enquiry-hub",
	"description": "Dev-only test tooling for the Marthrown Enquiry Hub WordPress plugin. Nothing in here is deployed to the server.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"giorgiosironi/eris": "^0.14.1",
		"yoast/phpunit-polyfills": "^3.1"
	},
	"autoload-dev": {
		"classmap": [
			"tests/"
		]
	},
	"scripts": {
		"test": "phpunit",
		"test:pure": "phpunit --testsuite pure",
		"test:wordpress": "phpunit --testsuite wordpress"
	},
	"config": {
		"sort-packages": true
	}
}
