# WordPress Plugin - ignore configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Log files
*.log

# Environment marker generated by CI at staging deploy time.
meh-environment.php

# Dependencies / build artefacts (built in CI, not committed)
/vendor/
/node_modules/
/build/

# Test artefacts
.phpunit.result.cache

# OS / editor cruft
.DS_Store
Thumbs.db
