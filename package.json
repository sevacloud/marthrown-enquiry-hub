{
  "name": "marthrown-enquiry-hub",
  "version": "0.1.0",
  "description": "React admin UI for the Marthrown Enquiry Hub WordPress plugin.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "lint:js": "wp-scripts lint-js",
    "test:php": "php vendor/phpunit/phpunit/phpunit",
    "test:php:pure": "php vendor/phpunit/phpunit/phpunit --testsuite pure",
    "test:php:wp": "php vendor/phpunit/phpunit/phpunit --testsuite wordpress",
    "test:js": "wp-scripts test-unit-js",
    "db:start": "node tests/db.js start",
    "db:stop": "node tests/db.js stop",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:php:wp-env": "wp-env run tests-cli --env-cwd=wp-content/plugins/marthrown-enquiry-hub vendor/bin/phpunit"
  },
  "devDependencies": {
    "@testing-library/react": "14.3.1",
    "@wordpress/api-fetch": "7.54.0",
    "@wordpress/components": "33.0.0",
    "@wordpress/env": "^10.0.0",
    "@wordpress/scripts": "^30.0.0",
    "@wordpress/url": "4.54.0"
  }
}
